local i18n = require("Global/i18n/api")

local DAMAGE_COLOR = "#e9543b"
local HORROR_COLOR = "#485cb3"

local ABILITY_TAG = "once_per_round"

local ABILITY_BTN_COLOR      = "clear"
local ABILITY_BTN_TEXT_COLOR = "#ffe9a8"
local ABILITY_BTN_POSITION   = "0 -105 -11"
local ABILITY_BTN_WIDTH      = "1400"
local ABILITY_BTN_HEIGHT     = "220"
local ABILITY_BTN_FONT_SIZE  = "110"

local ABILITY_COVER_COLOR      = "#161310"
local ABILITY_COVER_TEXT_COLOR = "#fff5e2"
local ABILITY_COVER_POSITION   = "0 -10 -11"
local ABILITY_COVER_WIDTH      = "1500"
local ABILITY_COVER_HEIGHT     = "1400"
local ABILITY_COVER_FONT_SIZE  = "110"

local data = {
    hp = 0,
    maxHp = nil,
    sp = 0,
    maxSp = nil,
    unbreakable = false,
    oncePerRound = false,
    abilityUsed = false,
}

local function abilityLabel()
    if data.abilityUsed then
        return i18n.getStrById("IM_undo_ability")
    end
    return i18n.getStrById("IM_use_ability")
end

local function syncAbilityTag()
    if data.oncePerRound then
        self.addTag(ABILITY_TAG)
    else
        self.removeTag(ABILITY_TAG)
    end
end

function onLoad(savedData)
    local sData = parseJson(savedData)
    if sData then
        data = sData
    end
    syncAbilityTag()
    self.UI.setXmlTable(getXmlTable())
end

function onSave()
    return JSON.encode(data)
end

function getXmlTable()
    local hpAtMax = data.maxHp ~= nil and data.hp == data.maxHp and not data.unbreakable
    local spAtMax = data.maxSp ~= nil and data.sp == data.maxSp and not data.unbreakable
    return {
        {
            tag = "Panel",
            attributes = {
                id = "damage",
                active = data.maxHp ~= nil and not spAtMax,
                width = "500", height = "300",
                scale = "0.1 0.1 0",
                position = "30 85 -11",
                rotation = "0 0 180",
            },
            children = {
                {
                    tag = "Button",
                    attributes = {
                        id = "damage_btn", onClick = "damage",
                        width = "500", height = "300",
                        position = "0 -40 0",
                        padding = "0 300 10 0",
                        fontSize = "290", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        textColor = DAMAGE_COLOR,
                        color = "clear",
                        text = tostring(data.hp),
                    },
                },
                {
                    tag = "Text",
                    attributes = {
                        id = "damage_txt",
                        position = "150 78 0",
                        fontSize = "70", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        color = "#fff5e2",
                        text = string.upper(i18n.getStrById("IM_damage")),
                    },
                },
            },
        },
        {
            tag = "Panel",
            attributes = {
                id = "damage_cls",
                active = spAtMax,
                width = "500", height = "300",
                scale = "0.1 0.1 0",
                position = "30 85 -11",
                rotation = "0 0 180",
            },
            children = {
                {
                    tag = "Button",
                    attributes = {
                        onClick = "ItemMatDestruct",
                        width = "500", height = "300",
                        position = "0 -40 0",
                        padding = "0 300 10 0",
                        fontSize = "290", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        textColor = DAMAGE_COLOR,
                        color = "clear",
                        text = "X",
                    },
                },
            },
        },
        {
            tag = "Panel",
            attributes = {
                id = "horror",
                active = data.maxSp ~= nil and not hpAtMax,
                width = "500", height = "300",
                scale = "0.1 0.1 0",
                position = "-30 85 -11",
                rotation = "0 0 180",
            },
            children = {
                {
                    tag = "Button",
                    attributes = {
                        id = "horror_btn", onClick = "horror",
                        width = "500", height = "300",
                        position = "0 -40 0",
                        padding = "300 0 10 0",
                        fontSize = "290", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        textColor = HORROR_COLOR,
                        color = "clear",
                        text = tostring(data.sp),
                    },
                },
                {
                    tag = "Text",
                    attributes = {
                        id = "horror_txt",
                        position = i18n.getLanguage() == "en" and "-70 -93 -11" or "-26 -93 -11",
                        fontSize = "70", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        color = "#fff5e2",
                        text = string.upper(i18n.getStrById("IM_horror")),
                    },
                },
            },
        },
        {
            tag = "Panel",
            attributes = {
                id = "horror_cls",
                active = hpAtMax,
                width = "500", height = "300",
                scale = "0.1 0.1 0",
                position = "-30 85 -11",
                rotation = "0 0 180",
            },
            children = {
                {
                    tag = "Button",
                    attributes = {
                        onClick = "ItemMatDestruct",
                        width = "500", height = "300",
                        position = "0 -40 0",
                        padding = "300 0 10 0",
                        fontSize = "290", fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        textColor = DAMAGE_COLOR,
                        color = "clear",
                        text = "X",
                    },
                },
            },
        },
        {
            tag = "Panel",
            attributes = {
                id = "ability_cover",
                active = data.oncePerRound and data.abilityUsed,
                width = ABILITY_COVER_WIDTH, height = ABILITY_COVER_HEIGHT,
                scale = "0.1 0.1 0",
                position = ABILITY_COVER_POSITION,
                rotation = "0 0 180",
                color = ABILITY_COVER_COLOR,
            },
            children = {
                {
                    tag = "Text",
                    attributes = {
                        id = "ability_cover_txt",
                        fontSize = ABILITY_COVER_FONT_SIZE, fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        color = ABILITY_COVER_TEXT_COLOR,
                        text = i18n.getStrById("IM_ability_used"),
                    },
                },
            },
        },
        {
            tag = "Panel",
            attributes = {
                id = "ability",
                active = data.oncePerRound,
                width = ABILITY_BTN_WIDTH, height = ABILITY_BTN_HEIGHT,
                scale = "0.1 0.1 0",
                position = ABILITY_BTN_POSITION,
                rotation = "0 0 180",
            },
            children = {
                {
                    tag = "Button",
                    attributes = {
                        id = "ability_btn",
                        onClick = "toggleAbility",
                        onMouseEnter = "abilityHoverEnter",
                        onMouseExit = "abilityHoverExit",
                        width = ABILITY_BTN_WIDTH, height = ABILITY_BTN_HEIGHT,
                        fontSize = ABILITY_BTN_FONT_SIZE, fontStyle = "Bold",
                        font = "Fonts/AdonisC",
                        textColor = ABILITY_BTN_TEXT_COLOR,
                        color = ABILITY_BTN_COLOR,
                        text = "",
                    },
                },
            },
        },
    }
end

function prepareTile()
    self.UI.setXmlTable(getXmlTable())
end

function damage(player, alt_click, id)
    if alt_click == "-1" then
        if data.maxHp and data.hp < data.maxHp then data.hp = data.hp + 1 end
    elseif alt_click == "-2" then
        if data.hp > 0 then data.hp = data.hp - 1 end
    end
    updateTile()
end

function horror(player, alt_click, id)
    if alt_click == "-1" then
        if data.maxSp and data.sp < data.maxSp then data.sp = data.sp + 1 end
    elseif alt_click == "-2" then
        if data.sp > 0 then data.sp = data.sp - 1 end
    end
    updateTile()
end

function toggleAbility(player, alt_click, id)
    if alt_click ~= "-1" then return end
    if not data.oncePerRound then return end
    data.abilityUsed = not data.abilityUsed
    updateAbility()
    self.UI.setAttribute('ability_btn', 'text', abilityLabel())
end

function abilityHoverEnter(player, alt_click, id)
    if not data.oncePerRound then return end
    self.UI.setAttribute('ability_btn', 'text', abilityLabel())
end

function abilityHoverExit(player, alt_click, id)
    self.UI.setAttribute('ability_btn', 'text', "")
end

function resetAbility()
    if not data.oncePerRound then return end
    data.abilityUsed = false
    updateAbility()
    self.UI.setAttribute('ability_btn', 'text', "")
end

function updateAbility()
    self.UI.setAttribute('ability', 'active', data.oncePerRound)
    self.UI.setAttribute('ability_cover', 'active', data.oncePerRound and data.abilityUsed)
end

function setData(d)
    data.hp = 0
    data.sp = 0
    data.maxHp = d.hp
    data.maxSp = d.sp
    data.unbreakable = d.unbreakable or false
    data.oncePerRound = d.oncePerRound or false
    data.abilityUsed = false
    syncAbilityTag()
    prepareTile()
end

function updateTile()
    local hpAtMax = data.maxHp ~= nil and data.hp == data.maxHp and not data.unbreakable
    local spAtMax = data.maxSp ~= nil and data.sp == data.maxSp and not data.unbreakable
    self.UI.setAttribute('damage', 'active', data.maxHp ~= nil and not spAtMax)
    self.UI.setAttribute('damage_cls', 'active', spAtMax)
    self.UI.setAttribute('horror', 'active', data.maxSp ~= nil and not hpAtMax)
    self.UI.setAttribute('horror_cls', 'active', hpAtMax)
    self.UI.setAttribute('damage_btn', 'text', data.hp)
    self.UI.setAttribute('damage_btn', 'textColor', DAMAGE_COLOR)
    self.UI.setAttribute('horror_btn', 'text', data.sp)
    self.UI.setAttribute('horror_btn', 'textColor', HORROR_COLOR)
end

function ItemMatDestruct()
    Global.call("onItemMatDestruct", self)
end

function parseJson(memo)
    if not memo or type(memo) ~= "string" then
        return nil
    end
    local success, result = pcall(function()
        return JSON.decode(memo)
    end)
    if success then
        return result
    else
        return nil
    end
end
